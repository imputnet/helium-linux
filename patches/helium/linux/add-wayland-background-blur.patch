+void WaylandSurface::set_blur_region(
+    std::optional<std::vector<gfx::Rect>> region_px) {
+  pending_state_.blur_region_px.clear();
+  if (!root_window_) {
+    return;
+  }
+
+  if (region_px) {
+    pending_state_.blur_region_px = *region_px;
+  }
+
+  if (apply_state_immediately_) {
+    ApplyBlurRegion();
+    state_.blur_region_px = pending_state_.blur_region_px;
+  }
+}
+
+void WaylandSurface::ApplyBlurRegion() {
+  auto* manager = connection_->background_blur_manager();
+  if (!manager || !manager->SupportsBlur()) {
+    return;
+  }
+
+  const auto& region_px = pending_state_.blur_region_px;
+  if (!background_blur_) {
+    if (region_px.empty()) {
+      return;
+    }
+
+    background_blur_ = manager->CreateSurface(surface_.get());
+  }
+
+  background_blur_->SetRegion(
+      region_px.empty()
+          ? nullptr
+          : CreateAndAddRegion(region_px, GetWaylandScale(pending_state_))
+                .get());
+}
