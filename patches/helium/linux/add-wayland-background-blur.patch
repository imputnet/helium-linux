+
+#ifndef UI_OZONE_PLATFORM_WAYLAND_HOST_BACKGROUND_BLUR_MANAGER_H_
+#define UI_OZONE_PLATFORM_WAYLAND_HOST_BACKGROUND_BLUR_MANAGER_H_
+
+#include <memory>
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+#include "ui/ozone/platform/wayland/common/wayland_object.h"
+
+namespace ui {
+
+class WaylandConnection;
+
+// Per-surface blur-behind effect.
+class BackgroundBlurSurface {
+ public:
+  BackgroundBlurSurface(wl::Object<ext_background_effect_surface_v1> effect);
+  BackgroundBlurSurface(org_kde_kwin_blur_manager* kde_manager,
+                        wl_surface* surface);
+  BackgroundBlurSurface(const BackgroundBlurSurface&) = delete;
+  BackgroundBlurSurface& operator=(const BackgroundBlurSurface&) = delete;
+  ~BackgroundBlurSurface();
+
+  // Sets the region of the surface with a blurred background. A null region
+  // removes the effect. Applied on the next wl_surface.commit.
+  void SetRegion(wl_region* region);
+
+ private:
+  wl::Object<ext_background_effect_surface_v1> effect_;
+
+  raw_ptr<org_kde_kwin_blur_manager> kde_manager_ = nullptr;
+  raw_ptr<wl_surface> surface_ = nullptr;
+  wl::Object<org_kde_kwin_blur> kde_blur_;
+};
+
+// Wraps ext_background_effect_manager_v1, falling back to
+// org_kde_kwin_blur_manager on KWin versions that predate the ext protocol.
+class BackgroundBlurManager
+    : public wl::GlobalObjectRegistrar<BackgroundBlurManager> {
+ public:
+  static constexpr char kExtInterfaceName[] =
+      "ext_background_effect_manager_v1";
+  static constexpr char kKdeInterfaceName[] = "org_kde_kwin_blur_manager";
+
+  static void Instantiate(WaylandConnection* connection,
+                          wl_registry* registry,
+                          uint32_t name,
+                          const std::string& interface,
+                          uint32_t version);
+
+  BackgroundBlurManager();
+  BackgroundBlurManager(const BackgroundBlurManager&) = delete;
+  BackgroundBlurManager& operator=(const BackgroundBlurManager&) = delete;
+  ~BackgroundBlurManager();
+
+  bool SupportsBlur() const;
+
+  std::unique_ptr<BackgroundBlurSurface> CreateSurface(wl_surface* surface);
+
+ private:
+  static void OnCapabilities(void* data,
+                             ext_background_effect_manager_v1* manager,
+                             uint32_t flags);
+
+  wl::Object<ext_background_effect_manager_v1> ext_manager_;
+  bool ext_supports_blur_ = false;
+
+  wl::Object<org_kde_kwin_blur_manager> kde_manager_;
+};
+
+}  // namespace ui
