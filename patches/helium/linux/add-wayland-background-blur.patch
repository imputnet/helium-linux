+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "ui/ozone/platform/wayland/host/background_blur_manager.h"
+
+#include <blur-client-protocol.h>
+#include <ext-background-effect-v1-client-protocol.h>
+
+#include "base/check.h"
+#include "base/logging.h"
+#include "ui/ozone/platform/wayland/host/wayland_connection.h"
+
+namespace ui {
+
+namespace {
+constexpr uint32_t kVersion = 1;
+}  // namespace
+
+BackgroundBlurSurface::BackgroundBlurSurface(
+    wl::Object<ext_background_effect_surface_v1> effect)
+    : effect_(std::move(effect)) {}
+
+BackgroundBlurSurface::BackgroundBlurSurface(
+    org_kde_kwin_blur_manager* kde_manager,
+    wl_surface* surface)
+    : kde_manager_(kde_manager), surface_(surface) {}
+
+BackgroundBlurSurface::~BackgroundBlurSurface() = default;
+
+void BackgroundBlurSurface::SetRegion(wl_region* region) {
+  if (effect_) {
+    ext_background_effect_surface_v1_set_blur_region(effect_.get(), region);
+    return;
+  }
+
+  // A null region blurs the whole surface in KDE's protocol, so the effect
+  // has to be removed explicitly.
+  if (!region) {
+    if (kde_blur_) {
+      org_kde_kwin_blur_manager_unset(kde_manager_, surface_);
+      kde_blur_.reset();
+    }
+
+    return;
+  }
+
+  if (!kde_blur_) {
+    kde_blur_.reset(org_kde_kwin_blur_manager_create(kde_manager_, surface_));
+  }
+
+  org_kde_kwin_blur_set_region(kde_blur_.get(), region);
+  org_kde_kwin_blur_commit(kde_blur_.get());
+}
+
+// static
+void BackgroundBlurManager::Instantiate(WaylandConnection* connection,
+                                        wl_registry* registry,
+                                        uint32_t name,
+                                        const std::string& interface,
+                                        uint32_t version) {
+  if (!wl::CanBind(interface, version, kVersion, kVersion)) {
+    return;
+  }
+
+  auto& manager = connection->background_blur_manager_;
+  if (!manager) {
+    manager = std::make_unique<BackgroundBlurManager>();
+  }
+
+  if (interface == kExtInterfaceName && !manager->ext_manager_) {
+    manager->ext_manager_ =
+        wl::Bind<ext_background_effect_manager_v1>(registry, name, kVersion);
+    if (!manager->ext_manager_) {
+      LOG(ERROR) << "Failed to bind ext_background_effect_manager_v1";
+      return;
+    }
+
+    static constexpr ext_background_effect_manager_v1_listener kListener = {
+        .capabilities = &OnCapabilities,
+    };
+    ext_background_effect_manager_v1_add_listener(manager->ext_manager_.get(),
+                                                  &kListener, manager.get());
+  } else if (interface == kKdeInterfaceName && !manager->kde_manager_) {
+    manager->kde_manager_ =
+        wl::Bind<org_kde_kwin_blur_manager>(registry, name, kVersion);
+    if (!manager->kde_manager_) {
+      LOG(ERROR) << "Failed to bind org_kde_kwin_blur_manager";
+    }
+  }
+}
+
+BackgroundBlurManager::BackgroundBlurManager() = default;
+
+BackgroundBlurManager::~BackgroundBlurManager() = default;
+
+bool BackgroundBlurManager::SupportsBlur() const {
+  return ext_supports_blur_ || kde_manager_;
+}
+
+std::unique_ptr<BackgroundBlurSurface> BackgroundBlurManager::CreateSurface(
+    wl_surface* surface) {
+  if (ext_supports_blur_) {
+    return std::make_unique<BackgroundBlurSurface>(
+        wl::Object<ext_background_effect_surface_v1>(
+            ext_background_effect_manager_v1_get_background_effect(
+                ext_manager_.get(), surface)));
+  }
+
+  CHECK(kde_manager_);
+  return std::make_unique<BackgroundBlurSurface>(kde_manager_.get(), surface);
+}
+
+// static
+void BackgroundBlurManager::OnCapabilities(
+    void* data,
+    ext_background_effect_manager_v1* manager,
+    uint32_t flags) {
+  static_cast<BackgroundBlurManager*>(data)->ext_supports_blur_ =
+      flags & EXT_BACKGROUND_EFFECT_MANAGER_V1_CAPABILITY_BLUR;
+}
+
+}  // namespace ui
