+// Converts |rrect| in DIP to pixel rects that follow its rounded corners.
+std::vector<gfx::Rect> GetRoundedRectRegion(const SkRRect& rrect, float scale) {
+  SkRRect scaled;
+  rrect.transform(SkMatrix::Scale(scale, scale), &scaled);
+
+  SkRegion region;
+  region.setPath(SkPath::RRect(scaled),
+                 SkRegion(scaled.getBounds().roundOut()));
+
+  std::vector<gfx::Rect> rects;
+  for (SkRegion::Iterator it(region); !it.done(); it.next()) {
+    rects.push_back(gfx::SkIRectToRect(it.rect()));
+  }
+
+  return rects;
+}
