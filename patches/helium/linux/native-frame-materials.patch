+// Converts |rrect| in DIP to pixel rects that follow its rounded corners. They
+// are whole DIPs, as Wayland takes them in surface coordinates, where thinner
+// rects would end up empty.
+std::vector<gfx::Rect> GetRoundedRectRegion(const SkRRect& rrect, float scale) {
+  SkRegion region;
+  region.setPath(SkPath::RRect(rrect), SkRegion(rrect.getBounds().roundOut()));
+
+  std::vector<gfx::Rect> rects;
+  for (SkRegion::Iterator it(region); !it.done(); it.next()) {
+    rects.push_back(
+        gfx::ScaleToEnclosingRect(gfx::SkIRectToRect(it.rect()), scale));
+  }
+
+  return rects;
+}
